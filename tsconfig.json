{
    "compilerOptions": {
        "sourceMap": true,
        "allowSyntheticDefaultImports": true,
        "module": "NodeNext",
        "outDir": "./built",
        "strict": true,
        "target": "es6",
        "skipLibCheck": true,
        "types": ["mocha", "node"]
    },
    "ts-node": {
        "transpileOnly": true,
        "compilerOptions": {
            "rootDir": "."
        }
    },
    "include": [
        "./bin/*",
        "codemancer/js/*",
        "./server/*",
        "./test/*",
        "./wdio.conf.ts",
        "./webpack.config.ts",
        "./.eslint.config.ts"
    ],
    "exclude": ["built"]
}
